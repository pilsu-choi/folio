# syntax=docker/dockerfile:1
# Customer image: folio + the customer's project (pipelines/, schemas/, mappers.py).
#   docker build -f Dockerfile.project --build-arg FOLIO_IMAGE=folio:0.1.0 \
#       --build-arg PROJECT_DIR=./my-project -t acme/folio:2026.10 <context>
# (project-template/Dockerfile generated by `folio` scaffolding does the same for a standalone project.)
ARG FOLIO_IMAGE=folio:0.1.0
FROM ${FOLIO_IMAGE}
ARG PROJECT_DIR=project
COPY --chown=10001:10001 ${PROJECT_DIR}/ /app/project/
ENV FOLIO_CONFIG_DIR=/app/project
