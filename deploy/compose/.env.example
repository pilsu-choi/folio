# Copy to .env and replace every CHANGE_ME. Placeholders only - never commit real secrets.
# Use URL-safe passwords (letters, digits, - _ . ~): they are embedded in connection URLs.

# Bundled infra (postgres/rabbitmq/opensearch/minio) + PP-StructureV3 structure server on GPU.
# Pick exactly one structure profile: gpu (default, NVIDIA container toolkit) | cpu (no GPU, ~40x slower, ~12 GB RAM) | dev (heuristic).
# External infra (FR-25): remove `infra`, then set the *_URL variables below.
COMPOSE_PROFILES=infra,gpu

FOLIO_TAG=0.1.0
# Private registry prefix incl. trailing slash (offline/air-gapped), empty = local/Docker Hub names.
FOLIO_REGISTRY=
FOLIO_PROJECT_DIR=../../project-template
FOLIO_API_PORT=8080
FOLIO_LOG_LEVEL=INFO

# Required secrets (compose refuses to start when unset)
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# Optional bundled-infra names
# POSTGRES_USER=folio
# POSTGRES_DB=folio
# RABBITMQ_USER=folio
# MINIO_ROOT_USER=folio
# FOLIO_BUCKET=folio-artifacts
# OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Structure backend is chosen by the profile above (gpu/cpu = PP-StructureV3, dev = heuristic).
# FOLIO_MODELS_DIR=/srv/folio/models   # host dir with model weights instead of the named volume
# cpu profile only: FOLIO_STRUCTURE_CPUS=4  FOLIO_STRUCTURE_CPU_THREADS=4  FOLIO_STRUCTURE_MEMORY=14g

# ---- External infrastructure (uncomment and drop the `infra` profile) ----
# FOLIO_DATABASE_URL=postgresql+psycopg://user:CHANGE_ME@db.example:5432/folio
# PGVECTOR_DSN=postgresql://user:CHANGE_ME@db.example:5432/app
# FOLIO_BROKER_URL=amqp://user:CHANGE_ME@mq.example:5672//
# OPENSEARCH_URL=https://os.example:9200
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=
# MILVUS_URI=http://milvus.example:19530
# S3_ENDPOINT_URL=https://s3.example
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# FOLIO_STORAGE_URI=s3://my-bucket/folio
# (POSTGRES_PASSWORD / RABBITMQ_PASSWORD / MINIO_ROOT_PASSWORD may then be any non-empty dummy value.)

# ---- Model endpoints ----
# FOLIO_STRUCTURE_URL=http://structure:9000
# Default embedding = bundled stub. Real endpoint (TEI / vLLM, OpenAI-compatible):
# FOLIO_EMBED_URL=http://tei.example/v1
# FOLIO_EMBED_MODEL=bge-m3
# FOLIO_EMBED_API_KEY=
# VLM for image content (parse vlm: auto). Unset = OCR path. Dev stub: add `vlm-stub` to COMPOSE_PROFILES and
# FOLIO_VLM_URL=http://vlm:8002/v1
# FOLIO_VLM_MODEL=
# FOLIO_RERANK_URL=

# ---- Example Airflow (FR-15, dev only): add `airflow` to COMPOSE_PROFILES ----
# The DAG starts folio containers through the host Docker socket (root-equivalent access).
# DOCKER_GID=1001                       # `stat -c %g /var/run/docker.sock`
# FOLIO_DOCKER_NETWORK=folio_default    # <compose project>_default
# AIRFLOW_PORT=8081
# AIRFLOW_IMAGE=apache/airflow:3.1.0-python3.12
