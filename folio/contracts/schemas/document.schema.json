{
  "$defs": {
    "Block": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "$ref": "#/$defs/BlockType"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "text_source": {
          "$ref": "#/$defs/TextSource"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "cells": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cells"
        },
        "spans": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CellSpan"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spans"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "level": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "heading level, 1 = top",
          "title": "Level"
        }
      },
      "required": [
        "type",
        "text_source"
      ],
      "title": "Block",
      "type": "object"
    },
    "BlockType": {
      "enum": [
        "heading",
        "paragraph",
        "list",
        "table",
        "kv",
        "figure",
        "caption",
        "code",
        "header",
        "footer"
      ],
      "title": "BlockType",
      "type": "string"
    },
    "CellSpan": {
      "additionalProperties": false,
      "description": "A merged cell: the cell at (row, col) covers rowspan x colspan grid cells.",
      "properties": {
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "col": {
          "minimum": 0,
          "title": "Col",
          "type": "integer"
        },
        "rowspan": {
          "default": 1,
          "minimum": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "colspan": {
          "default": 1,
          "minimum": 1,
          "title": "Colspan",
          "type": "integer"
        }
      },
      "required": [
        "row",
        "col"
      ],
      "title": "CellSpan",
      "type": "object"
    },
    "Page": {
      "additionalProperties": true,
      "properties": {
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based: PDF/image page, PPTX slide, XLSX sheet order, 1 for Markdown/TXT",
          "title": "Page"
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pt; None for XLSX/Markdown/TXT/native DOCX·HWPX",
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Blocks",
          "type": "array"
        }
      },
      "title": "Page",
      "type": "object"
    },
    "TextSource": {
      "enum": [
        "pdf_text",
        "ocr",
        "native",
        "vlm"
      ],
      "title": "TextSource",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "doc_id": {
      "title": "Doc Id",
      "type": "string"
    },
    "source_uri": {
      "title": "Source Uri",
      "type": "string"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "mime_type": {
      "title": "Mime Type",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    },
    "meta": {
      "additionalProperties": true,
      "title": "Meta",
      "type": "object"
    }
  },
  "required": [
    "doc_id",
    "source_uri",
    "content_hash",
    "mime_type"
  ],
  "title": "Document",
  "type": "object"
}
