{
  "$defs": {
    "GenerationConfig": {
      "additionalProperties": false,
      "description": "Answer generation over search results (``generation:`` in the YAML; ``POST /v1/chat``). Off when absent.",
      "properties": {
        "chat": {
          "$ref": "#/$defs/StepSpec",
          "description": "chat step fn(messages, **opts) -> str"
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "instruction prompt override; passages are appended",
          "title": "System"
        },
        "rewrite": {
          "default": true,
          "description": "rewrite follow-ups into a standalone search query",
          "title": "Rewrite",
          "type": "boolean"
        },
        "max_context_tokens": {
          "default": 6000,
          "description": "passage budget (top hit always kept)",
          "minimum": 1,
          "title": "Max Context Tokens",
          "type": "integer"
        },
        "max_history_tokens": {
          "default": 2000,
          "description": "history budget, oldest turns dropped first",
          "minimum": 0,
          "title": "Max History Tokens",
          "type": "integer"
        }
      },
      "title": "GenerationConfig",
      "type": "object"
    },
    "RetrievalConfig": {
      "additionalProperties": false,
      "description": "Search settings for the pipeline's index (``retrieval:`` in the YAML). Requests may override only\n``k``, ``mode`` and ``filters``; field weights, fusion and rerank stay in config.",
      "properties": {
        "fn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "custom retriever factory(sink, embed, **settings)",
          "title": "Fn"
        },
        "mode": {
          "default": "hybrid",
          "enum": [
            "hybrid",
            "bm25",
            "vector"
          ],
          "title": "Mode",
          "type": "string"
        },
        "k": {
          "default": 10,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "fields": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "BM25 fields -> weight",
          "title": "Fields",
          "type": "object"
        },
        "rrf_k": {
          "default": 60,
          "minimum": 1,
          "title": "Rrf K",
          "type": "integer"
        },
        "candidates": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "per-leg candidates; default max(k*3, 30)",
          "title": "Candidates"
        },
        "rerank": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_filters": {
          "items": {
            "type": "string"
          },
          "title": "Required Filters",
          "type": "array"
        }
      },
      "title": "RetrievalConfig",
      "type": "object"
    },
    "StepSpec": {
      "additionalProperties": false,
      "properties": {
        "fn": {
          "title": "Fn",
          "type": "string"
        },
        "opts": {
          "additionalProperties": true,
          "title": "Opts",
          "type": "object"
        }
      },
      "required": [
        "fn"
      ],
      "title": "StepSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "default": "default",
      "title": "Name",
      "type": "string"
    },
    "parse": {
      "$ref": "#/$defs/StepSpec"
    },
    "chunk": {
      "$ref": "#/$defs/StepSpec"
    },
    "map": {
      "anyOf": [
        {
          "$ref": "#/$defs/StepSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "embed": {
      "anyOf": [
        {
          "$ref": "#/$defs/StepSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "sink": {
      "additionalProperties": true,
      "title": "Sink",
      "type": "object"
    },
    "retrieval": {
      "$ref": "#/$defs/RetrievalConfig"
    },
    "generation": {
      "anyOf": [
        {
          "$ref": "#/$defs/GenerationConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "storage": {
      "default": ".folio/artifacts",
      "title": "Storage",
      "type": "string"
    },
    "config_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "dir holding schemas/ and mappers.py",
      "title": "Config Dir"
    }
  },
  "required": [
    "sink"
  ],
  "title": "PipelineConfig",
  "type": "object"
}
